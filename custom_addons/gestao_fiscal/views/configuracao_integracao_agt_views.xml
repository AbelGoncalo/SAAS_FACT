<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_configuracao_integracao_agt_list" model="ir.ui.view">
        <field name="name">configuracao.integracao.agt.list</field>
        <field name="model">configuracao.integracao.agt</field>
        <field name="arch" type="xml">
            <list>
                <field name="empresa_id"/>
                <field name="ambiente"/>
                <field name="schema_version"/>
                <field name="product_id"/>
                <field name="product_version"/>
                <field name="activa"/>
            </list>
        </field>
    </record>
    <record id="view_configuracao_integracao_agt_form" model="ir.ui.view">
        <field name="name">configuracao.integracao.agt.form</field>
        <field name="model">configuracao.integracao.agt</field>
        <field name="arch" type="xml">
            <form string="Configuração da Integração AGT">
                <sheet>
                    <group string="Integração">
                        <field name="empresa_id"/>
                        <field name="ambiente"/>
                        <field name="schema_version"/>
                        <field name="activa"/>
                    </group>
                    <group string="Software">
                        <field name="product_id"/>
                        <field name="product_version"/>
                        <field name="software_validation_number"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_configuracao_integracao_agt" model="ir.actions.act_window">
        <field name="name">Configurações AGT</field>
        <field name="res_model">configuracao.integracao.agt</field>
        <field name="view_mode">list,form</field>
    </record>
   
</odoo>