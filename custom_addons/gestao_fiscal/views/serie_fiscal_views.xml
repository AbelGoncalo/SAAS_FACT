<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista -->
    <record id="view_serie_fiscal_list" model="ir.ui.view">
        <field name="name">serie.fiscal.list</field>
        <field name="model">serie.fiscal</field>
        <field name="arch" type="xml">
            <list string="Séries Fiscais">
                <field name="empresa_id"/>
                <field name="ano"/>
                <field name="tipo_documento"/>
                <field name="estabelecimento_codigo"/>
                <field name="indicador_contingencia"/>
                <field name="codigo_serie_agt"/>
                <field name="estado"/>
            </list>
        </field>
    </record>
    <!-- Formulário -->
    <record id="view_serie_fiscal_form" model="ir.ui.view">
        <field name="name">serie.fiscal.form</field>
        <field name="model">serie.fiscal</field>
        <field name="arch" type="xml">
            <form string="Série Fiscal">
                <sheet>
                    <header>
                        <button
                            name="action_solicitar_serie"
                            string="Solicitar Série"
                            type="object"
                            class="btn-primary"
                            invisible="estado != 'rascunho'"
                        />
                        <button
                            name="action_marcar_autorizada"
                            string="Marcar como Autorizada"
                            type="object"
                            invisible="estado != 'pendente_agt'"
                        />
                        <button
                            name="action_marcar_rejeitada"
                            string="Marcar como Rejeitada"
                            type="object"
                            invisible="estado != 'pendente_agt'"
                        />
                        <button
                            name="action_inactivar"
                            string="Inactivar"
                            type="object"
                            invisible="estado != 'autorizada'"
                        />
                        <field
                            name="estado"
                            widget="statusbar"
                            statusbar_visible="rascunho,pendente_agt,autorizada,rejeitada,inactiva"
                        />
                    </header>
                    <group>
                        <group string="Dados da Série">
                            <field name="empresa_id"/>
                            <field name="ano"/>
                            <field name="tipo_documento"/>
                            <field name="estabelecimento_codigo"/>
                            <field name="indicador_contingencia"/>
                        </group>
                        <group string="Identificação">
                            <field name="identificador_solicitacao"/>
                            <field name="codigo_serie_agt"/>
                        </group>
                    </group>
                    <group string="Autorização AGT">
                        <group>
                            <field name="quantidade_autorizada"/>
                        </group>
                        <group>
                            <field name="primeiro_numero_documento"/>
                            <field name="ultimo_numero_documento"/>
                        </group>
                    </group>
                    <group string="Observações">
                        <field name="observacao"/>
                    </group>
                    <notebook>
                        <page string="Comunicações AGT">
                            <field name="comunicacao_agt_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="tipo_operacao"/>
                                    <field name="identificador_operacao"/>
                                    <field name="estado"/>
                                    <field name="data_envio"/>
                                    <field name="data_resposta"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Acção -->
    <record id="action_serie_fiscal" model="ir.actions.act_window">
        <field name="name">Séries Fiscais</field>
        <field name="res_model">serie.fiscal</field>
        <field name="view_mode">list,form</field>
    </record>
   
</odoo>